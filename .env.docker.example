# Configuration de la stack docker compose. Copiez ce fichier en .env :
#
#   cp .env.docker.example .env
#   printf 'JWT_SECRET=%s\n' "$(openssl rand -base64 48)" >> .env
#
# Référence complète des variables de l'API : server/.env.example et
# docs/installation.md §3.

# --- Obligatoire ---
# Secret de signature des jetons. Sans lui, la stack refuse de démarrer :
# un secret connu permettrait à n'importe qui de forger un jeton admin.
JWT_SECRET=

# Mot de passe PostgreSQL (interne à la stack, non exposé).
POSTGRES_PASSWORD=changez-moi

# --- Réseau ---
# Port publié sur la machine hôte.
PUBLIC_PORT=8080
# URL par laquelle les utilisateurs accèdent à Parqueo. Sert aux liens des
# emails (satisfaction) et à la redirection SSO — à ajuster derrière un reverse
# proxy ou un nom de domaine.
PUBLIC_URL=http://localhost:8080

# --- Base de données ---
POSTGRES_USER=parqueo
POSTGRES_DB=parqueo

# Crée le compte admin@parqueo.local / admin1234 au premier démarrage.
# Passez à false une fois votre propre compte administrateur en place.
SEED_ON_START=true

# --- Optionnel : notifications email ---
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Parqueo <no-reply@exemple.fr>

# --- Optionnel : ingestion d'inventaire (agent, agent GLPI) ---
# Jeton partagé présenté par l'agent en en-tête X-Parqueo-Token.
# INVENTORY_TOKEN=

# --- Optionnel : SSO Microsoft Entra ID ---
# SSO_TENANT_ID=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
