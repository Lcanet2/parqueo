# Configuration de la stack docker compose.
#
# Pour INSTALLER Parqueo, vous n'avez pas besoin de ce fichier : install.sh le
# génère, secrets compris.
#
#   curl -fsSL https://parqueo.fr/install.sh | sh
#
# Ce modèle sert à travailler sur les sources :
#
#   cp .env.docker.example .env
#   printf 'JWT_SECRET=%s\n' "$(openssl rand -base64 48)" >> .env
#
# Référence complète des variables de l'API : server/.env.example et
# docs/installation.md §3.

# --- Obligatoire ---
# Secret de signature des jetons. Sans lui, la stack refuse de démarrer :
# un secret connu permettrait à n'importe qui de forger un jeton admin.
JWT_SECRET=

# Mot de passe PostgreSQL (interne à la stack, non exposé).
POSTGRES_PASSWORD=changez-moi

# --- Réseau ---
# Port publié sur la machine hôte (stack de développement uniquement).
PUBLIC_PORT=8080
# URL par laquelle les utilisateurs accèdent à Parqueo. Sert aux liens des
# emails (satisfaction) et à la redirection SSO.
PUBLIC_URL=http://localhost:8080

# Nom de domaine public (stack de production). Renseigné, Caddy obtient un
# certificat Let's Encrypt au premier démarrage et le renouvelle seul ; les
# ports 80 et 443 doivent être joignables depuis Internet. Laissé vide, Parqueo
# répond en HTTP simple.
# DOMAIN=support.entreprise.fr

# --- Base de données ---
POSTGRES_USER=parqueo
POSTGRES_DB=parqueo

# Pose la catégorie et l'équipe par défaut sur une base vierge — sans elles,
# aucun ticket n'est ouvrable. Aucun compte n'est créé : l'administrateur se
# crée depuis le premier écran de l'application. Sans effet sur une base déjà
# amorcée, vous pouvez laisser true.
SEED_ON_START=true

# --- Optionnel : notifications email ---
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Parqueo <no-reply@exemple.fr>

# --- Optionnel : ingestion d'inventaire (agent, agent GLPI) ---
# Jeton partagé présenté par l'agent en en-tête X-Parqueo-Token.
# INVENTORY_TOKEN=

# --- Optionnel : SSO Microsoft Entra ID ---
# SSO_TENANT_ID=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
