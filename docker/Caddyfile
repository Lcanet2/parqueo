# Serveur du conteneur « web » : sert le client compilé, proxifie /api vers
# l'API, et gère TLS tout seul.
#
# L'adresse du site vient de l'environnement :
#   SITE_ADDRESS=:80                      → HTTP simple (évaluation locale)
#   SITE_ADDRESS=support.entreprise.fr    → HTTPS, certificat Let's Encrypt
#                                           obtenu et renouvelé automatiquement
#
# C'est tout ce qui sépare un essai d'une mise en production : Caddy demande le
# certificat au premier démarrage dès que l'adresse est un nom de domaine, et
# redirige HTTP vers HTTPS de lui-même.
{
	# Pas de directive `email` : elle exige un argument, et un Caddyfile n'a pas
	# de conditionnelle — laissée vide, elle empêchait Caddy de démarrer. Let's
	# Encrypt ne la réclame pas, et c'est un réglage de moins à expliquer.
	#
	# Le journal d'accès complet n'apporte rien ici et remplit le disque ;
	# les erreurs, si.
	log {
		level ERROR
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# 10 Mo de pièce jointe côté application, 5 Mo pour les rapports
	# d'inventaire : la marge couvre l'encodage multipart.
	request_body {
		max_size 12MB
	}

	header {
		# Le navigateur ne devine pas le type d'un fichier servi.
		X-Content-Type-Options nosniff
		# L'application n'a aucune raison d'être encadrée par un tiers.
		X-Frame-Options DENY
		Referrer-Policy same-origin
		# Ne pas annoncer la version du serveur.
		-Server
		# Content-Security-Policy : seuls les scripts servis par Parqueo
		# s'exécutent. Le jeton de session vit dans localStorage ; sans cette
		# politique, la moindre injection de script suffirait à le voler.
		#  - style-src 'unsafe-inline' : React pose des attributs style ;
		#  - img-src data: blob: : aperçus des pièces jointes et icônes en ligne ;
		#  - frame-ancestors 'none' : remplace X-Frame-Options pour les
		#    navigateurs récents.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv

		# Les fichiers produits par Vite portent un hachage dans leur nom : leur
		# contenu ne change jamais pour une URL donnée.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Tout le reste — index.html avant tout — doit être revalidé à chaque
		# visite, sinon le navigateur garde après une mise à jour un index.html
		# qui demande des fichiers hachés disparus : page blanche.
		#
		# Le matcher porte sur le chemin DEMANDÉ : `header` s'applique avant la
		# réécriture de try_files. Un ancien `header /index.html` ne couvrait
		# donc ni « / » ni « /tickets/12 », qui servent pourtant index.html —
		# et le navigateur les mettait en cache de lui-même faute de consigne.
		@hors_assets not path /assets/*
		header @hors_assets Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
