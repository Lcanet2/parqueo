DATABASE_URL="postgresql://parqueo:parqueo_dev@localhost:5432/parqueo?schema=public"

# Secret de signature des jetons. Laissé vide volontairement : l'API refuse de
# démarrer sans lui, ou avec un secret de moins de 16 caractères — un secret
# devinable permet de forger un jeton d'administrateur. Générez le vôtre :
#
#   openssl rand -base64 48
#
JWT_SECRET=""
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Parqueo <no-reply@parqueo.local>"

# URL publique du serveur, utilisée dans les liens des emails (défaut : http://localhost:PORT)
# APP_URL="https://parqueo.exemple.fr"

# --- SSO Microsoft Entra ID (OIDC) — laisser vide pour désactiver ---
# App registration single-tenant : seuls les comptes de ton annuaire peuvent se connecter.
# SSO_TENANT_ID=""
# SSO_CLIENT_ID=""
# SSO_CLIENT_SECRET=""
# URL de redirection déclarée dans l'app registration (défaut : APP_URL + /api/auth/sso/callback)
# SSO_REDIRECT_URI=""
# Domaines email autorisés en garde-fou, séparés par des virgules (optionnel)
# SSO_ALLOWED_DOMAINS="ta-boite.fr"
# Où renvoyer le navigateur après connexion SSO (défaut : CLIENT_ORIGIN ou /)
# SSO_POST_LOGIN_URL=""

# Clôture auto des tickets résolus après N jours sans activité (0 = désactivé, défaut : 7)
# AUTO_CLOSE_DAYS=7

# Ingestion d'inventaire (POST /api/inventory, /api/inventory/glpi) : un agent,
# un script ou l'agent GLPI y remonte le matériel. Token partagé présenté par
# l'appelant en en-tête X-Parqueo-Token (ou Authorization: Bearer). Laisser vide
# pour désactiver.
# INVENTORY_TOKEN=""

# --- Connecteur Microsoft Intune (inventaire sans agent, via Graph) ---
# Réutilise l'app registration Entra du SSO ci-dessus. Accordez-lui en plus la
# permission applicative Graph « DeviceManagementManagedDevices.Read.All » avec
# consentement admin, puis passez INTUNE_ENABLED à true.
# INTUNE_ENABLED=false
# Cadence de la synchronisation de fond, en heures (0 = seulement à la demande).
# INTUNE_SYNC_HOURS=6

# --- Scan réseau SNMP (découverte sans agent : imprimantes, switches, NAS…) ---
# SNMP_ENABLED=false
# Plages à scanner, CIDR séparés par des virgules.
# SNMP_RANGES="192.168.1.0/24,10.0.0.0/28"
# Communauté SNMP v2c (lecture seule).
# SNMP_COMMUNITY="public"
# Cadence du scan de fond, en heures (0 = seulement à la demande depuis l'UI).
# SNMP_SCAN_HOURS=0

# Collecteur email : créer des tickets depuis une boîte IMAP (désactivé si IMAP_HOST vide)
# Les réponses aux notifications (sujet « Ticket #n ») deviennent des commentaires.
# IMAP_HOST=""
# IMAP_PORT=993
# IMAP_USER="support@exemple.fr"
# IMAP_PASS=""
# IMAP_TLS=true
# IMAP_POLL_SECONDS=60
# Catégorie des tickets créés par email (défaut : première catégorie)
# IMAP_CATEGORY_ID=1
