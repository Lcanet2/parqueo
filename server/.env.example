DATABASE_URL="postgresql://parqueo:parqueo_dev@localhost:5432/parqueo?schema=public"
JWT_SECRET="change-me"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Parqueo <no-reply@parqueo.local>"

# URL publique du serveur, utilisée dans les liens des emails (défaut : http://localhost:PORT)
# APP_URL="https://parqueo.exemple.fr"

# --- SSO Microsoft Entra ID (OIDC) — laisser vide pour désactiver ---
# App registration single-tenant : seuls les comptes de ton annuaire peuvent se connecter.
# SSO_TENANT_ID=""
# SSO_CLIENT_ID=""
# SSO_CLIENT_SECRET=""
# URL de redirection déclarée dans l'app registration (défaut : APP_URL + /api/auth/sso/callback)
# SSO_REDIRECT_URI=""
# Domaines email autorisés en garde-fou, séparés par des virgules (optionnel)
# SSO_ALLOWED_DOMAINS="ta-boite.fr"
# Où renvoyer le navigateur après connexion SSO (défaut : CLIENT_ORIGIN ou /)
# SSO_POST_LOGIN_URL=""

# Clôture auto des tickets résolus après N jours sans activité (0 = désactivé, défaut : 7)
# AUTO_CLOSE_DAYS=7

# Collecteur email : créer des tickets depuis une boîte IMAP (désactivé si IMAP_HOST vide)
# Les réponses aux notifications (sujet « Ticket #n ») deviennent des commentaires.
# IMAP_HOST=""
# IMAP_PORT=993
# IMAP_USER="support@exemple.fr"
# IMAP_PASS=""
# IMAP_TLS=true
# IMAP_POLL_SECONDS=60
# Catégorie des tickets créés par email (défaut : première catégorie)
# IMAP_CATEGORY_ID=1
