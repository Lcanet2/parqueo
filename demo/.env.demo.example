# Configuration de l'instance de démonstration.
#
#   cp .env.demo.example .env
#   printf 'JWT_SECRET=%s\nPOSTGRES_PASSWORD=%s\n' \
#     "$(openssl rand -base64 36 | tr -d '\n/+=')" \
#     "$(openssl rand -base64 36 | tr -d '\n/+=')" >> .env

# Nom de domaine public. Caddy demande un certificat Let's Encrypt à son nom :
# l'enregistrement DNS doit déjà pointer vers cette machine, et les ports 80 et
# 443 être joignables depuis Internet.
DOMAIN=demo.parqueo.fr

# Générés — ne pas les recopier d'une autre instance.
JWT_SECRET=
POSTGRES_PASSWORD=

# Version des images. `latest` suit les publications ; épinglez pour figer.
PARQUEO_VERSION=latest
